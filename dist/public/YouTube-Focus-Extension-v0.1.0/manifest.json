{
  "manifest_version": 3,
  "name": "YouTube Focus",
  "version": "0.1.0",
  "description": "A free, intent-focused YouTube blocker foundation.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YouTube Focus",
    "default_popup": "popup.html"
  }
}